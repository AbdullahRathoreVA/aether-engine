# Copy to .env and fill in. .env is gitignored and never leaves this machine.

# ============================================================================
# REQUIRED - without this the engine runs but earns exactly $0
# ============================================================================
# Your product's checkout link.
#
# !! PAKISTAN: DO NOT USE GUMROAD. Verified 2026-07-24 - Gumroad pays out only
# !! via PayPal or Stripe direct-bank and Pakistan is restricted on BOTH. You
# !! can make sales there and never withdraw them. Same for Payhip, Lemon
# !! Squeezy, Etsy, Buy Me a Coffee.
# !! USE: Dodo Payments (dodopayments.com) -> pays out to Payoneer / Wise.
# !!      or Payoneer Checkout -> your own link, funds land in Payoneer.
CHECKOUT_URL=

# Where the generated site will live. Set after running scripts/deploy.ps1.
# Example: https://yourusername.github.io/aether-engine
SITE_BASE_URL=

PRODUCT_NAME=AI Job-Search Toolkit
PRODUCT_PRICE=$14

# ============================================================================
# OPTIONAL - revenue tracking via Dodo Payments API
# ============================================================================
DODO_API_KEY=
DODO_BASE=https://live.dodopayments.com

# ============================================================================
# HIGH-TICKET FUNNEL - the second price point on every page
# Same traffic, two offers: a $14 impulse buy and a service for the rare
# visitor who wants the builder rather than the template.
# ============================================================================
SHOWCASE_ENABLED=1
SHOWCASE_NAME=Titan Omega
SHOWCASE_URL=https://careermind2026-project-titan-omega.hf.space
SHOWCASE_TAGLINE=an autonomous AI command centre with 12 agent divisions, built and deployed solo
SERVICE_NAME=AI automation build-outs
SERVICE_PRICE_FROM=$400
# Your Upwork profile, email (mailto:...), or WhatsApp link. Blank = no hire button.
SERVICE_CONTACT=

# ============================================================================
# OPTIONAL - Reddit. Without these, Reddit harvesting is best-effort: roughly
# half the subreddits get rate-limited per sweep (the others are unaffected).
# Free fix: https://www.reddit.com/prefs/apps -> create app -> type "script".
# ============================================================================
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ============================================================================
# OPTIONAL - LLM. Leave all blank to run on free local templates.
# Best free option: install Ollama, then `ollama pull llama3.2`
# ============================================================================
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Groq has a generous free tier: https://console.groq.com/keys
GROQ_API_KEY=

ANTHROPIC_API_KEY=

# ============================================================================
# TUNING
# ============================================================================
HOST=127.0.0.1
PORT=7717

INTERVAL_HARVEST=900
INTERVAL_SCORE=120
INTERVAL_GENERATE=600
INTERVAL_SEO=3600
INTERVAL_REVENUE=1800

# Let the healer write fixes to disk automatically. Off by default: it always
# backs up and syntax-checks first, but you should read the first few patches.
AUTO_PATCH=0
