# Copy to .env. It is gitignored and never leaves this machine.
# The product itself (name, price, checkout link, sources) lives in aether.json.
# A value set here overrides the same field in aether.json.
CHECKOUT_URL=
SITE_BASE_URL=
SITE_AUTHOR=

# Optional second offer shown under every page. Off unless SHOWCASE_URL is set.
SHOWCASE_NAME=
SHOWCASE_URL=
SHOWCASE_TAGLINE=
SERVICE_NAME=
SERVICE_PRICE_FROM=
SERVICE_CONTACT=

# Optional: reliable Reddit (free "script" app at https://www.reddit.com/prefs/apps).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Optional LLM for the daemon. Leave all blank and an agent (or you) writes instead.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-fable-5-2
ANTHROPIC_EFFORT=medium
ANTHROPIC_DAILY_USD=2
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Optional: revenue tracking through the Dodo Payments API.
DODO_API_KEY=
DODO_BASE=https://live.dodopayments.com

HOST=127.0.0.1
PORT=7717
AUTO_PATCH=0
